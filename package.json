{
  "name": "qa-automation-showcase",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end, API, accessibility and performance test automation showcase: Playwright + TypeScript and k6, run in GitHub Actions.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test --project=anonymous --project=chromium",
    "test:cross-browser": "playwright test --project=firefox --project=mobile",
    "test:a11y": "playwright test --project=a11y",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "k6:smoke": "k6 run k6/smoke.js",
    "k6:load": "k6 run k6/load.js",
    "k6:stress": "k6 run k6/stress.js",
    "k6:spike": "k6 run k6/spike.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
